# MediClaim AI — Backend Environment
# SQLite is the default (no PostgreSQL driver needed on Python 3.14)
# Switch to postgresql+asyncpg://... when asyncpg supports Python 3.14

DATABASE_URL=sqlite+aiosqlite:///./mediclaim.db
UPLOAD_DIR=uploads

# AI Extraction (optional — simulation mode if empty)
OPENAI_API_KEY=

# Auth (optional — dev bypass if empty)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# S3 Storage (optional — local disk if empty)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
